  "_metadata": {
    "name": "Cross-Tradition Sacred Festival Registry",
    "version": "1.0",
    "festival_count": 32,
    "anchor_types_supported": [
      "solar_date",
      "solar_term",
      "lunar_month_day",
      "lunar_quarter_after_term",
      "tibetan_lunar_month_full",
      "tibetan_lunar_month_range",
