    ],
    "epistemic_tag": "[SOURCE: multi-tradition] — see per-festival source notes",
    "design_notes": [
      "Festival dates are computed at query time using the anchor rules. Stored dates would drift.",
      "Lunar anchors use astronomical New Moon and Full Moon (ephem-computed).",
      "Tibetan months use Phugpa reckoning by default (Tibetan month 4 ≈ Gregorian May/June).",
      "Where traditions differ on dates (e.g., Vesak between Sri Lanka and Tibet), the canonical anchor is noted."
    ]
  },
  "festivals": [
    {
      "id": "saga_dawa",
      "name_english": "Saga Dawa",
      "name_native": "ས་ག་ཟླ་བ་",
      "name_native_transliteration": "Sa-ga zla-ba",
      "tradition": "Tibetan Buddhist",
      "description": "The month commemorating the birth, enlightenment, and parinirvana of Shakyamuni Buddha. 'Saga' refers to the star/mansion (Visakha in Indian system, Root Mansion 氐 in Chinese) under which the Buddha is said to have been born. The full month is considered sacred; the full moon day within it is the most auspicious.",
      "anchor_type": "tibetan_lunar_month_range",
      "anchor_data": {
        "tibetan_month": 4,
        "duration": "full_month"
      },
      "associated_lunar_mansion": 2,
      "duration_days": 30,
      "merit_multiplier_classical": 100000,
      "practices": ["circumambulation of sacred mountains", "lamp offerings", "vow observance", "liberating life", "meditation", "tree planting"],
      "source_note": "[SOURCE: Tibetan Buddhist tradition. Mama Food Forest text May 2026.]"
    },
    {
      "id": "vesak",
      "name_english": "Vesak (Buddha Day)",
      "name_native": "वैशाख",
      "name_native_transliteration": "Vaiśākha Purnima",
      "tradition": "Buddhist (Theravada, Mahayana)",
      "description": "The full moon day commemorating the Buddha's birth, enlightenment, and parinirvana. In Theravada countries (Sri Lanka, Thailand, Myanmar, etc.) this is THE Buddha day. In Tibetan tradition the full month around it is observed as Saga Dawa.",
      "anchor_type": "tibetan_lunar_month_full",
      "anchor_data": {
        "tibetan_month": 4,
        "day": "full_moon"
      },
      "associated_lunar_mansion": 2,
      "duration_days": 1,
      "source_note": "[SOURCE: Buddhist tradition; UN-recognized international observance since 1999]"
    },
